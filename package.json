{
  "name": "project-command-center",
  "productName": "Project Command Center",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "serve": "node server/server.cjs",
    "build": "tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "it.personal.projectcommandcenter",
    "productName": "Project Command Center",
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
